// bbox = south, west, north, east around the raceway ways 107684749 / 1205208205 (centre ~12.9206 N, 101.009 E).
[out:json][timeout:120][bbox:12.910,100.996,12.932,101.022];
(
  way["highway"];
  way["building"];
  way["landuse"];
  way["leisure"];
  way["amenity"];
  way["natural"];
  way["waterway"];
  way["barrier"];
  way["man_made"];
  relation["leisure"];
  relation["landuse"];
  node["name"];
  node["amenity"];
  node["barrier"];
);
out geom qt;
