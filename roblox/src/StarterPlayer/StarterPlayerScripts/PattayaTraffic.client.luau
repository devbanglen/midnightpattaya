-- Ambient traffic (RayCity field traffic). Cars drive closed loops in the left-hand lane
-- (ReplicatedStorage.PattayaTraffic, generated by tools/mapgen/traffic.py). Each car's position is a pure function
-- of the server clock, so every client shows the same traffic with no network cost. Only cars near the camera get a
-- model, taken from a pool.
-- Traffic is solid for your own car (client physics): hitting it is a real knock. A traffic car about to run into
-- your car from behind turns into a ghost for a moment instead of shoving it. Passing close without touching is a
-- near miss: the server pays nitro (and a tip during a job) for it.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local dataModule = ReplicatedStorage:WaitForChild("PattayaTraffic", 60)
local remotes = ReplicatedStorage:WaitForChild("PattayaRemotes", 60)
if not (dataModule and remotes) then
	return
end
local routesData = require(dataModule)
local NearMiss = remotes:WaitForChild("NearMiss", 30)
local player = Players.LocalPlayer

local ORIGIN = Vector3.new(20000, 0, 0) -- PattayaBuilder.ORIGIN
local ROAD_Y = 1
local RADIUS = 650 -- studs from the camera focus that get a model
local MAX_MODELS = 70
local NEAR_GAP = 7 -- studs of side clearance that count as a near miss
local NEAR_SPEED = 70 -- studs/s the player must be doing

-- routes ------------------------------------------------------------------------------------------------------------
local routes = {}
for _, r in routesData do
	local pts, cum = {}, {0}
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for i = 1, #r.pts, 2 do
		local p = Vector3.new(r.pts[i] + ORIGIN.X, ROAD_Y, r.pts[i + 1] + ORIGIN.Z)
		table.insert(pts, p)
		minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
		minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
	end
	for i = 2, #pts do
		cum[i] = cum[i - 1] + (pts[i] - pts[i - 1]).Magnitude
	end
	table.insert(routes, {pts = pts, cum = cum, length = cum[#cum], speed = r.speed, phase = r.phase, kinds = r.kinds,
		minX = minX, maxX = maxX, minZ = minZ, maxZ = maxZ})
end

local function pointAt(r, s: number): Vector3
	s %= r.length
	local cum = r.cum
	local lo, hi = 1, #cum
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= s then lo = mid else hi = mid end
	end
	local seg = cum[hi] - cum[lo]
	return r.pts[lo]:Lerp(r.pts[hi], if seg > 0 then (s - cum[lo]) / seg else 0)
end

-- models --------------------------------------------------------------------------------------------------------
local BODY_COLORS = {
	{Color3.fromRGB(235, 235, 235), Color3.fromRGB(160, 165, 170), Color3.fromRGB(25, 25, 30), Color3.fromRGB(190, 30, 35),
		Color3.fromRGB(240, 110, 170), Color3.fromRGB(40, 160, 70)},  -- sedans / taxis
	{Color3.fromRGB(30, 90, 200), Color3.fromRGB(20, 120, 210)},       -- songthaew (Pattaya baht bus)
	{Color3.fromRGB(240, 240, 240), Color3.fromRGB(200, 200, 205)},    -- vans
}
-- {length, width, body height, cabin}
local SHAPES = {
	{len = 14, wid = 6.6, h = 2.4},
	{len = 16, wid = 7, h = 2.6},
	{len = 16, wid = 7.2, h = 6},
}

local folder = Instance.new("Folder")
folder.Name = "PattayaTraffic"
folder.Parent = workspace

local function part(model: Model, root: BasePart?, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?,
	shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CastShadow = false
	if shape then p.Shape = shape end
	p.CanQuery, p.CanTouch = false, false
	if root then
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		p.CFrame = root.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = root, p
		w.Parent = p
	else
		p.Anchored = true
		p.CanCollide = true
	end
	p.Parent = model
	return p
end

local function makeCar(kind: number): Model
	local sh = SHAPES[kind + 1]
	local colors = BODY_COLORS[kind + 1]
	local color = colors[math.random(1, #colors)]
	local m = Instance.new("Model")
	m.Name = "Traffic" .. kind
	-- root = lower body, the only collider; its bottom sits 1.4 studs above the road (wheel radius)
	local root = part(m, nil, Vector3.new(sh.wid, sh.h, sh.len), CFrame.new(), color)
	root.Name = "Body"
	m.PrimaryPart = root
	local glass = Color3.fromRGB(30, 40, 50)
	if kind == 0 then
		part(m, root, Vector3.new(sh.wid - 0.6, 2, sh.len * 0.5), CFrame.new(0, sh.h / 2 + 1, 0.5), glass, Enum.Material.Glass)
		part(m, root, Vector3.new(sh.wid - 0.8, 0.3, sh.len * 0.46), CFrame.new(0, sh.h / 2 + 2.1, 0.5), color)
		if color == BODY_COLORS[1][5] or color == BODY_COLORS[1][6] then -- taxi-meter sign on pink/green cabs
			part(m, root, Vector3.new(2.4, 0.8, 1), CFrame.new(0, sh.h / 2 + 2.6, 0.5), Color3.fromRGB(255, 230, 80), Enum.Material.Neon)
		end
	elseif kind == 1 then
		-- cab at the front (-Z is forward), covered bench bed behind
		part(m, root, Vector3.new(sh.wid - 0.4, 2.6, 4.5), CFrame.new(0, sh.h / 2 + 1.3, -4.6), glass, Enum.Material.Glass)
		part(m, root, Vector3.new(sh.wid + 0.2, 0.4, 9.5), CFrame.new(0, sh.h / 2 + 4.4, 2.6), Color3.fromRGB(240, 240, 240))
		for _, x in {-1, 1} do
			part(m, root, Vector3.new(0.3, 4.2, 9.5), CFrame.new(x * (sh.wid / 2), sh.h / 2 + 2.2, 2.6), color)
				.Transparency = 0.55
		end
	else
		part(m, root, Vector3.new(sh.wid - 0.4, 2, 2.5), CFrame.new(0, 1.2, -sh.len / 2 + 0.6), glass, Enum.Material.Glass)
	end
	for _, z in {-1, 1} do
		for _, x in {-1, 1} do
			part(m, root, Vector3.new(1.2, 2.8, 2.8), CFrame.new(x * (sh.wid / 2 - 0.4), -sh.h / 2, z * (sh.len / 2 - 2.6)),
				Color3.fromRGB(20, 20, 22), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		end
		-- head lights at the front (-Z), tail lights at the back
		for _, x in {-1, 1} do
			part(m, root, Vector3.new(1.4, 0.6, 0.2), CFrame.new(x * (sh.wid / 2 - 1.1), 0.2, z * (sh.len / 2 + 0.05)),
				if z < 0 then Color3.fromRGB(255, 250, 220) else Color3.fromRGB(230, 20, 20), Enum.Material.Neon)
		end
	end
	m:SetAttribute("Lift", 1.4 + sh.h / 2)
	m:SetAttribute("HalfLen", sh.len / 2)
	m:SetAttribute("HalfWid", sh.wid / 2)
	return m
end

local pool = {[0] = {}, [1] = {}, [2] = {}}
local active = {} -- [key] = {model, root, ghostUntil, side, near}
local count = 0

local function acquire(kind: number): Model?
	local list = pool[kind]
	local m = table.remove(list)
	if not m then
		if count >= MAX_MODELS then
			return nil
		end
		count += 1
		m = makeCar(kind)
	end
	m.Parent = folder
	return m
end

local function release(entry, kind: number)
	entry.model.Parent = nil
	table.insert(pool[kind], entry.model)
end

local function setGhost(entry, on: boolean)
	if entry.ghost == on then
		return
	end
	entry.ghost = on
	entry.root.CanCollide = not on
	for _, p in entry.model:GetChildren() do
		if p:IsA("BasePart") then
			p.LocalTransparencyModifier = if on then 0.6 else 0
		end
	end
end

local function myCar(): BasePart?
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if seat and seat:IsA("VehicleSeat") and seat.Parent:GetAttribute("RaceCar") then
		return seat.Parent.PrimaryPart
	end
	return nil
end

-- update --------------------------------------------------------------------------------------------------------------
local lastNearAt = 0
local roots, cframes = {}, {}
RunService.Heartbeat:Connect(function()
	local cam = workspace.CurrentCamera
	local car = myCar()
	local focus = if car then car.Position else (cam and cam.Focus.Position or Vector3.zero)
	local t = workspace:GetServerTimeNow()
	local seen = {}
	table.clear(roots)
	table.clear(cframes)
	local carVel = car and car.AssemblyLinearVelocity
	local carSpeed = carVel and Vector3.new(carVel.X, 0, carVel.Z).Magnitude or 0
	for ri, r in routes do
		if focus.X < r.minX - RADIUS or focus.X > r.maxX + RADIUS or focus.Z < r.minZ - RADIUS or focus.Z > r.maxZ + RADIUS then
			continue
		end
		local n = #r.kinds
		for k = 1, n do
			local s = r.phase + (k - 1) * r.length / n + t * r.speed
			local p = pointAt(r, s)
			local dx, dz = p.X - focus.X, p.Z - focus.Z
			if dx * dx + dz * dz > RADIUS * RADIUS then
				continue
			end
			local key = ri * 1000 + k
			local entry = active[key]
			if not entry then
				local m = acquire(r.kinds[k])
				if not m then
					continue
				end
				entry = {model = m, root = m.PrimaryPart, kind = r.kinds[k], ghost = false, ghostUntil = 0,
					lift = m:GetAttribute("Lift"), halfLen = m:GetAttribute("HalfLen"), halfWid = m:GetAttribute("HalfWid")}
				active[key] = entry
			end
			seen[key] = true
			local ahead = pointAt(r, s + 6)
			local look = Vector3.new(ahead.X - p.X, 0, ahead.Z - p.Z)
			local cf = if look.Magnitude > 0.01
				then CFrame.lookAt(p + Vector3.new(0, entry.lift, 0), p + Vector3.new(look.X, entry.lift, look.Z))
				else CFrame.new(p + Vector3.new(0, entry.lift, 0))
			table.insert(roots, entry.root)
			table.insert(cframes, cf)
			-- interaction with my car, in the traffic car's frame (forward = -Z)
			if car then
				local rel = cf:PointToObjectSpace(car.Position)
				local lateral = math.abs(rel.X) - entry.halfWid - 3.5 -- 3.5 ~ half my car's width
				-- my car just ahead in its lane: ghost it rather than shove me
				-- (only when I'm stopped or slower in its direction; driving at it head-on is a real crash)
				local along = (carVel :: Vector3):Dot(cf.LookVector)
				if rel.Z < 0 and rel.Z > -(entry.halfLen + 16) and math.abs(rel.X) < entry.halfWid + 4
					and along > -10 and along < r.speed - 5 then
					entry.ghostUntil = t + 1.5
				end
				setGhost(entry, t < entry.ghostUntil)
				-- near miss: my car goes from one end of it to the other within NEAR_GAP of its side, without a knock
				local side = if rel.Z < -entry.halfLen then -1 elseif rel.Z > entry.halfLen then 1 else 0
				if side ~= 0 then
					if entry.side and entry.side ~= 0 and side ~= entry.side and entry.near and carSpeed > NEAR_SPEED
						and t - lastNearAt > 0.6 then
						lastNearAt = t
						if NearMiss then
							NearMiss:FireServer()
						end
					end
					entry.side = side
					entry.near = nil
				elseif lateral > 0 and lateral < NEAR_GAP and not entry.ghost then
					entry.near = if entry.near == nil then true else entry.near
				elseif lateral <= 0 then
					entry.near = false -- touched / overlapping: not a near miss
				end
			end
		end
	end
	if #roots > 0 then
		workspace:BulkMoveTo(roots, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for key, entry in active do
		if not seen[key] then
			active[key] = nil
			setGhost(entry, false)
			release(entry, entry.kind)
		end
	end
end)
