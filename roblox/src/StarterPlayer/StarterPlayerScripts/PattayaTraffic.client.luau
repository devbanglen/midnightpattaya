-- Ambient traffic (RayCity field traffic). Cars drive closed loops in the left-hand lane
-- (ReplicatedStorage.PattayaTraffic, generated by tools/mapgen/traffic.py). Each car's position is a pure function
-- of the server clock, so every client shows the same traffic with no network cost. Only cars near the camera get a
-- model, taken from a pool.
-- Traffic is solid for your own car (client physics): hitting it is a real knock. A traffic car about to run into
-- your car from behind turns into a ghost for a moment instead of shoving it. Passing close without touching is a
-- near miss: the server pays nitro (and a tip during a job) for it.
-- Collision model (workspace attribute CollisionModel, live; docs/RECOVERY_AND_COLLISION.md):
--   "physical" (default) = the solid boxes above, unchanged.
--   "arcade" = the boxes never collide. A swept box test against my car finds the hit, CarController applies the
--   scripted result (speed loss / spin / short loss of control from ReplicatedStorage.PattayaRecovery, never a
--   roll) through the client BindableEvent PlayerScripts.CarImpact, and the traffic car ghosts for 1.5 s.
-- Player attribute TrafficGhostUntil (server time, set after a rescue) ghosts every car near mine until then;
-- TrafficGhostAll = true (TestKit) skips arcade hits.
-- TestKit hook (Studio or workspace DevTest only): player attribute TK_HitTarget = a car key (route * 1000 + index)
-- ghosts every other car, so TK.hitTest meets exactly its target. Ignored in normal play.
-- Looks (team9, 2026-10-19): real vehicle meshes (sedan / taxi, hatch, scooter pair, tuk-tuk, songthaew, pickup, van)
-- from ReplicatedStorage.TrafficVehicles + TrafficVehicleTemplates, welded to the same single collision box as before
-- (now invisible). No template for a kind (or no module) = the box car below, unchanged. docs/TRAFFIC_VEHICLES.md
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local dataModule = ReplicatedStorage:WaitForChild("PattayaTraffic", 60)
local remotes = ReplicatedStorage:WaitForChild("PattayaRemotes", 60)
if not (dataModule and remotes) then
	return
end
local routesData = require(dataModule)
-- vehicle meshes (optional): any failure here leaves the box cars
local tvModule = ReplicatedStorage:FindFirstChild("TrafficVehicles")
local tvOk, TrafficVehicles = false, nil
if tvModule then
	tvOk, TrafficVehicles = pcall(require, tvModule)
	if not tvOk then
		warn("[PattayaTraffic] TrafficVehicles failed to load; box cars: " .. tostring(TrafficVehicles))
	end
end
local NearMiss = remotes:WaitForChild("NearMiss", 30)
local IS_STUDIO = RunService:IsStudio()
local player = Players.LocalPlayer
-- shared traffic maths + arcade hits; waited for briefly so the shared positions are used whenever it is installed
local recModule = ReplicatedStorage:WaitForChild("PattayaRecovery", 5)
local recOk, Recovery = false, nil
if recModule then
	recOk, Recovery = pcall(require, recModule)
	if not recOk then
		Recovery = nil
	end
end

local ORIGIN = Vector3.new(20000, 0, 0) -- PattayaBuilder.ORIGIN
local ROAD_Y = 1
local RADIUS = 650 -- studs from the camera focus that get a model
local MAX_MODELS = 70
local NEAR_GAP = 7 -- studs of side clearance that count as a near miss
local NEAR_SPEED = 70 -- studs/s the player must be doing
local NEAR_KEEP = 200 -- studs: cars this close to my car always get a model (taken from one beyond FAR_GIVE)
local FAR_GIVE = 350

-- routes ------------------------------------------------------------------------------------------------------------
-- With ReplicatedStorage.PattayaRecovery (the normal case) the loops, car keys, positions and headings come from its
-- shared functions (buildTrafficRoutes / forEachTrafficCar / trafficHeading): the same double-precision numbers
-- TestKit and the server's TrafficHit check use. The Vector3 build below is only the fallback without the module:
-- Vector3 is 32-bit, and with the epoch clock its positions drift ~700 studs (median) from the shared ones
-- (Studio rounds 3-5, docs/RECOVERY_AND_COLLISION.md section 13).
local SHARED = Recovery ~= nil and type(Recovery.forEachTrafficCar) == "function"
local routes = {}
if SHARED then
	routes = Recovery.buildTrafficRoutes(routesData, Recovery.TRAFFIC_ORIGIN_X, Recovery.TRAFFIC_ORIGIN_Z)
else
	for _, r in routesData do
		local pts, cum = {}, {0}
		local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
		for i = 1, #r.pts, 2 do
			local p = Vector3.new(r.pts[i] + ORIGIN.X, ROAD_Y, r.pts[i + 1] + ORIGIN.Z)
			table.insert(pts, p)
			minX, maxX = math.min(minX, p.X), math.max(maxX, p.X)
			minZ, maxZ = math.min(minZ, p.Z), math.max(maxZ, p.Z)
		end
		for i = 2, #pts do
			cum[i] = cum[i - 1] + (pts[i] - pts[i - 1]).Magnitude
		end
		table.insert(routes, {pts = pts, cum = cum, length = cum[#cum], speed = r.speed, phase = r.phase, kinds = r.kinds,
			minX = minX, maxX = maxX, minZ = minZ, maxZ = maxZ})
	end
end

local function pointAt(r, s: number): Vector3 -- fallback (legacy) routes only
	s %= r.length
	local cum = r.cum
	local lo, hi = 1, #cum
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if cum[mid] <= s then lo = mid else hi = mid end
	end
	local seg = cum[hi] - cum[lo]
	return r.pts[lo]:Lerp(r.pts[hi], if seg > 0 then (s - cum[lo]) / seg else 0)
end

-- heading of a car at arc s (unit x, z)
local function headingAt(r, s: number): (number, number)
	if SHARED then
		return Recovery.trafficHeading(r, s)
	end
	local p, ahead = pointAt(r, s), pointAt(r, s + 6)
	local look = Vector3.new(ahead.X - p.X, 0, ahead.Z - p.Z)
	if look.Magnitude > 0.01 then
		return look.Unit.X, look.Unit.Z
	end
	return 0, -1
end

-- models --------------------------------------------------------------------------------------------------------
local BODY_COLORS = {
	{Color3.fromRGB(235, 235, 235), Color3.fromRGB(160, 165, 170), Color3.fromRGB(25, 25, 30), Color3.fromRGB(190, 30, 35),
		Color3.fromRGB(240, 110, 170), Color3.fromRGB(40, 160, 70)},  -- sedans / taxis
	{Color3.fromRGB(30, 90, 200), Color3.fromRGB(20, 120, 210)},       -- songthaew (Pattaya baht bus)
	{Color3.fromRGB(240, 240, 240), Color3.fromRGB(200, 200, 205)},    -- vans
}
-- {length, width, body height, cabin}
local SHAPES = {
	{len = 14, wid = 6.6, h = 2.4},
	{len = 16, wid = 7, h = 2.6},
	{len = 16, wid = 7.2, h = 6},
}

local folder = Instance.new("Folder")
folder.Name = "PattayaTraffic"
-- which maths placed the cars ("shared" = PattayaRecovery, as TestKit and the server; TK.selfCheck prints it)
folder:SetAttribute("Positions", if SHARED then "shared" else "legacy")
folder.Parent = workspace

local function part(model: Model, root: BasePart?, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?,
	shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CastShadow = false
	if shape then p.Shape = shape end
	p.CanQuery, p.CanTouch = false, false
	if root then
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		p.CFrame = root.CFrame * offset
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1 = root, p
		w.Parent = p
	else
		p.Anchored = true
		p.CanCollide = true
	end
	p.Parent = model
	return p
end

local function makeCar(kind: number): Model
	local sh = SHAPES[kind + 1]
	local colors = BODY_COLORS[kind + 1]
	local color = colors[math.random(1, #colors)]
	local m = Instance.new("Model")
	m.Name = "Traffic" .. kind
	-- root = lower body, the only collider; its bottom sits 1.4 studs above the road (wheel radius)
	local root = part(m, nil, Vector3.new(sh.wid, sh.h, sh.len), CFrame.new(), color)
	root.Name = "Body"
	m.PrimaryPart = root
	m:SetAttribute("Lift", 1.4 + sh.h / 2)
	m:SetAttribute("HalfLen", sh.len / 2)
	m:SetAttribute("HalfWid", sh.wid / 2)
	-- mesh vehicle on the same collider: the Body stays the only collider, now invisible
	if tvOk then
		local ok, name = pcall(TrafficVehicles.build, kind, root, 1.4 + sh.h / 2, m)
		if ok and name then
			root.Transparency = 1
			return m
		elseif not ok then
			warn("[PattayaTraffic] mesh vehicle failed; box car: " .. tostring(name))
			for _, c in m:GetChildren() do
				if c ~= root then
					c:Destroy()
				end
			end
		end
	end
	local glass = Color3.fromRGB(30, 40, 50)
	if kind == 0 then
		part(m, root, Vector3.new(sh.wid - 0.6, 2, sh.len * 0.5), CFrame.new(0, sh.h / 2 + 1, 0.5), glass, Enum.Material.Glass)
		part(m, root, Vector3.new(sh.wid - 0.8, 0.3, sh.len * 0.46), CFrame.new(0, sh.h / 2 + 2.1, 0.5), color)
		if color == BODY_COLORS[1][5] or color == BODY_COLORS[1][6] then -- taxi-meter sign on pink/green cabs
			part(m, root, Vector3.new(2.4, 0.8, 1), CFrame.new(0, sh.h / 2 + 2.6, 0.5), Color3.fromRGB(255, 230, 80), Enum.Material.Neon)
		end
	elseif kind == 1 then
		-- cab at the front (-Z is forward), covered bench bed behind
		part(m, root, Vector3.new(sh.wid - 0.4, 2.6, 4.5), CFrame.new(0, sh.h / 2 + 1.3, -4.6), glass, Enum.Material.Glass)
		part(m, root, Vector3.new(sh.wid + 0.2, 0.4, 9.5), CFrame.new(0, sh.h / 2 + 4.4, 2.6), Color3.fromRGB(240, 240, 240))
		for _, x in {-1, 1} do
			part(m, root, Vector3.new(0.3, 4.2, 9.5), CFrame.new(x * (sh.wid / 2), sh.h / 2 + 2.2, 2.6), color)
				.Transparency = 0.55
		end
	else
		part(m, root, Vector3.new(sh.wid - 0.4, 2, 2.5), CFrame.new(0, 1.2, -sh.len / 2 + 0.6), glass, Enum.Material.Glass)
	end
	for _, z in {-1, 1} do
		for _, x in {-1, 1} do
			part(m, root, Vector3.new(1.2, 2.8, 2.8), CFrame.new(x * (sh.wid / 2 - 0.4), -sh.h / 2, z * (sh.len / 2 - 2.6)),
				Color3.fromRGB(20, 20, 22), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		end
		-- head lights at the front (-Z), tail lights at the back
		for _, x in {-1, 1} do
			part(m, root, Vector3.new(1.4, 0.6, 0.2), CFrame.new(x * (sh.wid / 2 - 1.1), 0.2, z * (sh.len / 2 + 0.05)),
				if z < 0 then Color3.fromRGB(255, 250, 220) else Color3.fromRGB(230, 20, 20), Enum.Material.Neon)
		end
	end
	return m
end

local pool = {[0] = {}, [1] = {}, [2] = {}}
local active = {} -- [key] = {model, root, ghostUntil, side, near}
local count = 0

local function acquire(kind: number): Model?
	local list = pool[kind]
	local m = table.remove(list)
	if not m then
		if count >= MAX_MODELS then
			return nil
		end
		count += 1
		m = makeCar(kind)
	end
	m.Parent = folder
	return m
end

local function release(entry, kind: number)
	entry.model.Parent = nil
	table.insert(pool[kind], entry.model)
end

local arcade = false -- CollisionModel == "arcade" this frame: the boxes never collide

local function setGhost(entry, on: boolean)
	if entry.ghost == on then
		return
	end
	entry.ghost = on
	entry.root.CanCollide = not on and not arcade
	for _, p in entry.model:GetChildren() do
		if p:IsA("BasePart") then
			p.LocalTransparencyModifier = if on then 0.6 else 0
		end
	end
end

local function myCar(): BasePart?
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if seat and seat:IsA("VehicleSeat") and seat.Parent:GetAttribute("RaceCar") then
		return seat.Parent.PrimaryPart
	end
	return nil
end

-- arcade hit: CarController (PlayerScripts.CarImpact) applies the result
local function reportImpact(info)
	local ps = player:FindFirstChild("PlayerScripts")
	local ev = ps and ps:FindFirstChild("CarImpact")
	if ev and ev:IsA("BindableEvent") then
		ev:Fire(info)
	end
end

-- my car against one traffic car (traffic frame cf, forward = -Z); returns true on a new hit
local function arcadeHit(entry, cf: CFrame, rel: Vector3, car: BasePart, carVel: Vector3, speed: number, t: number): boolean
	local prev = entry.lastRel
	entry.lastRel = Vector2.new(rel.X, rel.Z)
	if math.abs(rel.Y) > 6 or math.abs(rel.X) > entry.halfWid + 12 or math.abs(rel.Z) > entry.halfLen + 14 then
		if not (prev and math.abs(prev.X) < entry.halfWid + 12 and math.abs(prev.Y) < entry.halfLen + 14) then
			return false
		end
	end
	-- the touch test and the contact numbers: PattayaRecovery.hitFromWorld (unit-tested in tools/qa/tests)
	local ml = car.CFrame.LookVector
	local mlf = Vector3.new(ml.X, 0, ml.Z)
	mlf = if mlf.Magnitude > 0.1 then mlf.Unit else Vector3.new(0, 0, -1)
	local tl = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z).Unit
	local p, q = car.Position, cf.Position
	local info = Recovery.hitFromWorld(
		{x = p.X, z = p.Z, lx = mlf.X, lz = mlf.Z, vx = carVel.X, vz = carVel.Z},
		{x = q.X, z = q.Z, lx = tl.X, lz = tl.Z, speed = speed, halfWid = entry.halfWid, halfLen = entry.halfLen},
		prev and prev.X, prev and prev.Y)
	if not info then
		return false
	end
	info.trafficSpeed, info.at, info.tx, info.tz = speed, t, q.X, q.Z
	reportImpact(info)
	return true
end

-- update --------------------------------------------------------------------------------------------------------------
local lastNearAt = 0
local roots, cframes = {}, {}
-- this frame's state, read by placeCar
local F = {car = nil :: BasePart?, carVel = Vector3.zero, carSpeed = 0, t = 0, seen = {}, ghostUntil = 0,
	ghostAround = false, noHits = false, tkKey = nil :: number?}

-- one traffic car of this frame: model (pool), CFrame, and the interaction with my car
local function placeCar(key: number, x: number, z: number, d2: number, r, k: number, _ri: number, s: number)
	local car, t, seen = F.car, F.t, F.seen
	local entry = active[key]
	if not entry then
		local m = acquire(r.kinds[k])
		if not m and car and d2 < NEAR_KEEP * NEAR_KEEP then
			-- pool full: a car close to mine must exist (a car without a model is invisible and cannot be
			-- hit), so the farthest one not yet placed this frame gives up its model
			local farKey, farD = nil, FAR_GIVE * FAR_GIVE
			for k2, e2 in active do
				if not seen[k2] and (e2.d2 or 0) > farD and e2.kind == r.kinds[k] then
					farKey, farD = k2, e2.d2
				end
			end
			if farKey then
				local e2 = active[farKey]
				active[farKey] = nil
				setGhost(e2, false)
				release(e2, e2.kind)
				m = acquire(r.kinds[k])
			end
		end
		if not m then
			return
		end
		entry = {model = m, root = m.PrimaryPart, kind = r.kinds[k], ghost = false, ghostUntil = 0,
			lift = m:GetAttribute("Lift"), halfLen = m:GetAttribute("HalfLen"), halfWid = m:GetAttribute("HalfWid")}
		entry.root.CanCollide = not arcade
		m:SetAttribute("TrafficKey", key) -- TestKit (TK.selfCheck / hitTest) finds a car's model by its key
		active[key] = entry
	end
	seen[key] = true
	entry.d2 = d2
	local lx, lz = headingAt(r, s)
	local p = Vector3.new(x, ROAD_Y + entry.lift, z)
	local cf = CFrame.lookAt(p, p + Vector3.new(lx, 0, lz))
	table.insert(roots, entry.root)
	table.insert(cframes, cf)
	-- interaction with my car, in the traffic car's frame (forward = -Z)
	if car then
		local carVel = F.carVel
		local rel = cf:PointToObjectSpace(car.Position)
		local lateral = math.abs(rel.X) - entry.halfWid - 3.5 -- 3.5 ~ half my car's width
		-- my car just ahead in its lane: ghost it rather than shove me
		-- (only when I'm stopped or slower in its direction; driving at it head-on is a real crash)
		local along = carVel:Dot(cf.LookVector)
		if rel.Z < 0 and rel.Z > -(entry.halfLen + 16) and math.abs(rel.X) < entry.halfWid + 4
			and along > -10 and along < r.speed - 5 then
			entry.ghostUntil = t + 1.5
		end
		if F.tkKey and key ~= F.tkKey then
			entry.ghostUntil = math.max(entry.ghostUntil, t + 0.25) -- TestKit: only the target is real
		end
		-- just rescued: everything close to me stays a ghost until TrafficGhostUntil
		if F.ghostAround and math.abs(rel.X) < entry.halfWid + 20 and math.abs(rel.Z) < entry.halfLen + 30 then
			entry.ghostUntil = math.max(entry.ghostUntil, F.ghostUntil)
		end
		-- arcade: a touch is a scripted hit (no physics), then the car ghosts so it cannot hit twice
		if arcade and not F.noHits and t >= entry.ghostUntil
			and arcadeHit(entry, cf, rel, car, carVel, r.speed, t) then
			entry.ghostUntil = t + Recovery.get("Arcade_HitGhost")
			entry.near = false -- touched: not a near miss
		end
		entry.lastRel = Vector2.new(rel.X, rel.Z)
		setGhost(entry, t < entry.ghostUntil)
		-- near miss: my car goes from one end of it to the other within NEAR_GAP of its side, without a knock
		local side = if rel.Z < -entry.halfLen then -1 elseif rel.Z > entry.halfLen then 1 else 0
		if side ~= 0 then
			if entry.side and entry.side ~= 0 and side ~= entry.side and entry.near and F.carSpeed > NEAR_SPEED
				and t - lastNearAt > 0.6 then
				lastNearAt = t
				if NearMiss then
					NearMiss:FireServer()
				end
			end
			entry.side = side
			entry.near = nil
		elseif lateral > 0 and lateral < NEAR_GAP and not entry.ghost then
			entry.near = if entry.near == nil then true else entry.near
		elseif lateral <= 0 then
			entry.near = false -- touched / overlapping: not a near miss
		end
	end
end

RunService.Heartbeat:Connect(function()
	local cam = workspace.CurrentCamera
	local car = myCar()
	local focus = if car then car.Position else (cam and cam.Focus.Position or Vector3.zero)
	local t = workspace:GetServerTimeNow()
	local nowArcade = Recovery ~= nil and workspace:GetAttribute("CollisionModel") == "arcade"
	if nowArcade ~= arcade then
		arcade = nowArcade
		for _, entry in active do
			entry.root.CanCollide = not entry.ghost and not arcade
			entry.lastRel = nil
		end
	end
	local ghostUntil = player:GetAttribute("TrafficGhostUntil")
	F.ghostAround = type(ghostUntil) == "number" and ghostUntil > t
	F.ghostUntil = if F.ghostAround then ghostUntil else 0
	F.noHits = player:GetAttribute("TrafficGhostAll") == true
	local tkKey = player:GetAttribute("TK_HitTarget")
	if type(tkKey) ~= "number" or not (IS_STUDIO or workspace:GetAttribute("DevTest") == true) then
		tkKey = nil
	end
	F.tkKey = tkKey
	F.car, F.t = car, t
	F.seen = {}
	table.clear(roots)
	table.clear(cframes)
	local carVel = if car then car.AssemblyLinearVelocity else Vector3.zero
	F.carVel = carVel
	F.carSpeed = Vector3.new(carVel.X, 0, carVel.Z).Magnitude
	if SHARED then
		Recovery.forEachTrafficCar(routes, t, focus.X, focus.Z, RADIUS, placeCar)
	else
		for ri, r in routes do
			if focus.X < r.minX - RADIUS or focus.X > r.maxX + RADIUS or focus.Z < r.minZ - RADIUS or focus.Z > r.maxZ + RADIUS then
				continue
			end
			local n = #r.kinds
			for k = 1, n do
				local s = r.phase + (k - 1) * r.length / n + t * r.speed
				local p = pointAt(r, s)
				local dx, dz = p.X - focus.X, p.Z - focus.Z
				if dx * dx + dz * dz <= RADIUS * RADIUS then
					placeCar(ri * 1000 + k, p.X, p.Z, dx * dx + dz * dz, r, k, ri, s)
				end
			end
		end
	end
	if #roots > 0 then
		workspace:BulkMoveTo(roots, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for key, entry in active do
		if not F.seen[key] then
			active[key] = nil
			setGhost(entry, false)
			release(entry, entry.kind)
		end
	end
end)
